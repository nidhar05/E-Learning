DEBUG=True

# Default local setup uses SQLite.
# Set MYSQL_NAME(db name) to switch the backend to MySQL.
MYSQL_NAME=
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Optional integrations
OPENAI_API_KEY=
SUBTITLE_TARGET_LANGUAGE=en
SUBTITLE_TARGET_LABEL=English
WHISPER_TASK=transcribe

# Razorpay (required for real subscription payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend UPI receiver id (set in next_frontend env as NEXT_PUBLIC_UPI_ID)
NEXT_PUBLIC_UPI_ID=nidhusiva05@oksbi
